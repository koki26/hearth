# Rust
target/

# Godot (the cache lives in .godot/; per-asset *.import files hold import settings and are committed)
.godot/

# Server runtime data (TLS key!)
data/

# Exported client builds
dist/

# Screenshots from client/godot/tools/shot.gd
shots/

